APP_NAME="Data Capture Tool"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-production-domain.example
APP_TIMEZONE=Africa/Brazzaville

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=

WAREHOUSE_DB_CONNECTION=mysql
WAREHOUSE_DB_HOST=
WAREHOUSE_DB_PORT=3306
WAREHOUSE_DB_DATABASE=aho_azure_database
WAREHOUSE_DB_USERNAME=
WAREHOUSE_DB_PASSWORD=
WAREHOUSE_DB_TIMEOUT=5
WAREHOUSE_MYSQL_ATTR_SSL_CA=

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=cache
SESSION_STORE=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_SCHEME=tls
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6380
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default
REDIS_PERSISTENT=true
REDIS_TIMEOUT=5
REDIS_READ_TIMEOUT=60
REDIS_MAX_RETRIES=3

FILESYSTEM_DISK=local
AZURE_PUBLICATION_STORAGE_ENABLED=true
AZURE_ACCOUNT=afahobckpstorageaccount
AZURE_CONTAINER=afahobckpcontainer
AZURE_STORAGE_ENDPOINT=https://afahobckpstorageaccount.blob.core.windows.net
STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_SAS_TOKEN=

MICROSOFT_ENTRA_ENABLED=true
MICROSOFT_ENTRA_TENANT=
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=
MICROSOFT_ENTRA_REDIRECT_URI=https://your-production-domain.example/microsoft_authentication/callback
MICROSOFT_ENTRA_SCOPES="openid profile email User.Read"
MICROSOFT_ENTRA_LOCAL_LOGIN_ENABLED=false

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

BROADCAST_CONNECTION=log
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@dct.afro.who.int
MAIL_FROM_NAME="${APP_NAME}"
AHO_ADMIN_EMAIL=
AHO_ADMIN_EMAIL_NOTIFICATIONS=true
AHO_ADMIN_ACTIVITY_NOTIFICATIONS=true

PHP_FPM_MAX_CHILDREN=64
PHP_FPM_START_SERVERS=12
PHP_FPM_MIN_SPARE_SERVERS=8
PHP_FPM_MAX_SPARE_SERVERS=24
PHP_FPM_MAX_REQUESTS=500
START_QUEUE_WORKER=false
